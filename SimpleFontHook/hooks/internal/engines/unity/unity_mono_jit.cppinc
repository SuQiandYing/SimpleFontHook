static void* __cdecl MonoNewRuntimeInvoke(void* method, void* object,
    void** params, void** exception) {
    if (!g_monoOriginalRuntimeInvoke) return NULL;
    if (g_monoRuntimeInvokeGuard) {
        return g_monoOriginalRuntimeInvoke(method, object, params, exception);
    }

    g_monoRuntimeInvokeGuard = true;
    bool tmpObject = MonoIsTmpTextObject(object);
    bool uiObject = !tmpObject && MonoIsUiTextObject(object);
    const char* methodName = MonoRuntimeMethodName(method);
    bool setFont = methodName && strcmp(methodName, "set_font") == 0;
    bool lifecycle = methodName &&
        (strcmp(methodName, "Awake") == 0 ||
            strcmp(methodName, "OnEnable") == 0 ||
            strcmp(methodName, "LoadFontAsset") == 0);
    void* replacementAsset = NULL;
    void* replacementMaterial = NULL;
    void* sourceFont = NULL;
    if (InterlockedCompareExchange(&g_monoFontReady, 0, 0) != 0 &&
        g_monoApi.gcHandleGetTarget) {
        replacementAsset = g_monoReplacementFontAssetHandle
            ? g_monoApi.gcHandleGetTarget(g_monoReplacementFontAssetHandle) : NULL;
        replacementMaterial = g_monoReplacementMaterialHandle
            ? g_monoApi.gcHandleGetTarget(g_monoReplacementMaterialHandle) : NULL;
        sourceFont = g_monoSourceFontHandle
            ? g_monoApi.gcHandleGetTarget(g_monoSourceFontHandle) : NULL;
    }

    // Replace the managed argument before the game's setter sees it. This is
    // the zero-frame guard for newly instantiated dialogue/history entries.
    if (setFont && params && !g_monoCatSetFontJitActive) {
        if (tmpObject && replacementAsset) params[0] = replacementAsset;
        else if (uiObject && sourceFont) params[0] = sourceFont;
    }

    void* result = g_monoOriginalRuntimeInvoke(method, object, params, exception);
    if (lifecycle && replacementAsset && replacementMaterial && tmpObject) {
        MonoApplyTmpObjectImmediately(object, replacementAsset, replacementMaterial);
    } else if (lifecycle && sourceFont && uiObject) {
        MonoApplyUiTextObjectImmediately(object, sourceFont);
    }
    g_monoRuntimeInvokeGuard = false;
    return result;
}

static bool MonoInstallRuntimeInvokeHook() {
    if (InterlockedCompareExchange(&g_monoRuntimeInvokeHookInstalled, 0, 0) != 0)
        return true;
    if (!g_monoApi.runtimeInvoke) return false;
    g_monoOriginalRuntimeInvoke = g_monoApi.runtimeInvoke;
    LONG begin = DetourTransactionBegin();
    if (begin != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] runtime_invoke transaction begin failed=%ld", begin);
        return false;
    }
    DetourUpdateThread(GetCurrentThread());
    LONG attach = DetourAttach(&(PVOID&)g_monoOriginalRuntimeInvoke,
        MonoNewRuntimeInvoke);
    LONG commit = attach == NO_ERROR ? DetourTransactionCommit()
        : DetourTransactionAbort();
    if (attach != NO_ERROR || commit != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] runtime_invoke hook failed attach=%ld commit=%ld",
            attach, commit);
        g_monoOriginalRuntimeInvoke = NULL;
        return false;
    }
    InterlockedExchange(&g_monoRuntimeInvokeHookInstalled, 1);
    Utils::Trace("[DEBUG][UnityMono] runtime_invoke hook attached target=%p",
        g_monoApi.runtimeInvoke);
    return true;
}

