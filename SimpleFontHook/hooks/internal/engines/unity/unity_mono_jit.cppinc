static bool MonoIsExecutableAddress(const void* address) {
    if (!address) return false;
    MEMORY_BASIC_INFORMATION info = {};
    if (!VirtualQuery(address, &info, sizeof(info)) || info.State != MEM_COMMIT)
        return false;
    DWORD protection = info.Protect & 0xFF;
    bool executable = protection == PAGE_EXECUTE ||
        protection == PAGE_EXECUTE_READ ||
        protection == PAGE_EXECUTE_READWRITE ||
        protection == PAGE_EXECUTE_WRITECOPY;
    return executable && (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) == 0;
}

static void __cdecl MonoNewTmpSetTextJit(void* text, void* managedText) {
    pMonoManagedObjectSetter original = g_monoOriginalTmpSetTextJit;
    if (!original) return;
    if (g_monoTmpSetTextJitGuard || !MonoIsReplacementEnabled() ||
        !g_monoApi.gcHandleGetTarget || !g_monoApi.gcHandleNew) {
        original(text, managedText);
        return;
    }
    MonoGlyphMutationGuard mutation;
    if (!mutation.acquired) {
        original(text, managedText);
        return;
    }

    g_monoTmpSetTextJitGuard = true;
    void* originalText = text;
    void* originalManagedText = managedText;
    uint32_t textRoot = text ? g_monoApi.gcHandleNew(text, 1) : 0;
    uint32_t managedTextRoot = managedText
        ? g_monoApi.gcHandleNew(managedText, 1) : 0;
    if ((text && !textRoot) || (managedText && !managedTextRoot)) {
        if (managedTextRoot) MonoFreeHandle(managedTextRoot);
        if (textRoot) MonoFreeHandle(textRoot);
        g_monoTmpSetTextJitGuard = false;
        original(originalText, originalManagedText);
        return;
    }
    text = textRoot ? g_monoApi.gcHandleGetTarget(textRoot) : text;
    managedText = managedTextRoot
        ? g_monoApi.gcHandleGetTarget(managedTextRoot) : managedText;
    void* fontAsset = g_monoReplacementFontAssetHandle
        ? g_monoApi.gcHandleGetTarget(g_monoReplacementFontAssetHandle) : NULL;
    void* material = g_monoReplacementMaterialHandle
        ? g_monoApi.gcHandleGetTarget(g_monoReplacementMaterialHandle) : NULL;
    std::wstring additions = MonoRememberTextCharacters(managedText);
    bool fontReady = InterlockedCompareExchange(&g_monoFontReady, 0, 0) != 0;
    if (!additions.empty()) InterlockedExchange(&g_monoLastCharacterScanTick, 0);
    if (!additions.empty() && fontReady && fontAsset && material) {
        if (g_monoBindings.legacyTmp) {
            // A legacy TMP asset cannot grow in place. Rebuild it before the
            // game's setter creates a mesh, otherwise the new text is rendered
            // once with the previous glyph table and appears one frame late.
            InterlockedExchange(&g_monoLastCharacterScanTick, 0);
            bool glyphSetChanged = false;
            bool rebuilt = MonoCreateReplacementFontAsset(
                Config::ConfigVersion, &glyphSetChanged);
            fontAsset = rebuilt && g_monoReplacementFontAssetHandle
                ? g_monoApi.gcHandleGetTarget(
                    g_monoReplacementFontAssetHandle) : NULL;
            material = rebuilt && g_monoReplacementMaterialHandle
                ? g_monoApi.gcHandleGetTarget(
                    g_monoReplacementMaterialHandle) : NULL;
            Utils::Trace("[DEBUG][UnityMono] legacy TMP text glyphs prepared before setter codeUnits=%llu codePoints=%s rebuilt=%d changed=%d asset=%p material=%p",
                (unsigned long long)additions.size(),
                MonoDescribeCodePoints(additions, 32).c_str(),
                rebuilt ? 1 : 0, glyphSetChanged ? 1 : 0,
                fontAsset, material);
        } else {
            void* sourceFont = NULL;
            bool complete = false;
            bool populated = MonoEnsureModernSourceFont(fontAsset,
                Config::ConfigVersion, &sourceFont) &&
                MonoPopulateModernFontAsset(fontAsset, additions, &complete) &&
                MonoEnsureModernMaterialAtlas(fontAsset, material);
            Utils::Trace("[DEBUG][UnityMono] TMP text glyphs prepared before setter codeUnits=%llu codePoints=%s asset=%p populated=%d complete=%d",
                (unsigned long long)additions.size(),
                MonoDescribeCodePoints(additions, 32).c_str(), fontAsset,
                populated ? 1 : 0, complete ? 1 : 0);
        }
    }
    if (!fontReady && !additions.empty()) {
        Utils::Trace("[DEBUG][UnityMono] text glyphs remembered before font ready codeUnits=%llu codePoints=%s",
            (unsigned long long)additions.size(),
            MonoDescribeCodePoints(additions, 32).c_str());
    }

    bool appliedBeforeSetter = fontReady && g_monoBindings.legacyTmp &&
        !additions.empty() && fontAsset && material &&
        MonoApplyTmpObjectImmediately(text, fontAsset, material);
    original(text, managedText);
    if (fontReady && fontAsset && material) {
        if (appliedBeforeSetter) MonoForceTmpMeshUpdate(text);
        else MonoApplyTmpObjectImmediately(text, fontAsset, material);
    }
    if (managedTextRoot) MonoFreeHandle(managedTextRoot);
    if (textRoot) MonoFreeHandle(textRoot);
    g_monoTmpSetTextJitGuard = false;
}

static bool MonoInstallTmpSetTextJitHook() {
    LONG state = InterlockedCompareExchange(&g_monoTmpSetTextJitHookState, 0, 0);
    if (state == 1) return true;
    if (state != 0 || !g_monoApi.compileMethod || !g_monoBindings.tmpSetText)
        return false;
    if (InterlockedCompareExchange(&g_monoTmpSetTextJitHookState, -1, 0) != 0)
        return false;

    void* entry = g_monoApi.compileMethod(g_monoBindings.tmpSetText);
    if (!MonoIsExecutableAddress(entry)) {
        Utils::Trace("[DEBUG][UnityMono] TMP_Text.set_text JIT hook rejected entry=%p",
            entry);
        InterlockedExchange(&g_monoTmpSetTextJitHookState, 0);
        return false;
    }
    g_monoOriginalTmpSetTextJit =
        reinterpret_cast<pMonoManagedObjectSetter>(entry);
    LONG begin = DetourTransactionBegin();
    if (begin != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] TMP_Text.set_text JIT transaction begin failed=%ld",
            begin);
        g_monoOriginalTmpSetTextJit = NULL;
        InterlockedExchange(&g_monoTmpSetTextJitHookState, 0);
        return false;
    }
    DetourUpdateThread(GetCurrentThread());
    LONG attach = DetourAttach(&(PVOID&)g_monoOriginalTmpSetTextJit,
        MonoNewTmpSetTextJit);
    LONG commit = attach == NO_ERROR ? DetourTransactionCommit()
        : DetourTransactionAbort();
    if (attach != NO_ERROR || commit != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] TMP_Text.set_text JIT hook failed attach=%ld commit=%ld",
            attach, commit);
        g_monoOriginalTmpSetTextJit = NULL;
        InterlockedExchange(&g_monoTmpSetTextJitHookState, 0);
        return false;
    }
    InterlockedExchange(&g_monoTmpSetTextJitHookState, 1);
    Utils::Trace("[DEBUG][UnityMono] TMP_Text.set_text JIT hook attached target=%p trampoline=%p",
        entry, g_monoOriginalTmpSetTextJit);
    return true;
}

static void __cdecl MonoNewTmpSetFontJit(void* text, void* requestedFont) {
    pMonoManagedObjectSetter original = g_monoOriginalTmpSetFontJit;
    if (!original) return;
    void* font = requestedFont;
    if (!g_monoCatSetFontJitActive && MonoIsReplacementEnabled() &&
        InterlockedCompareExchange(&g_monoFontReady, 0, 0) != 0) {
        void* replacement = InterlockedCompareExchangePointer(
            reinterpret_cast<PVOID volatile*>(&g_monoReplacementFontAsset),
            NULL, NULL);
        if (replacement) font = replacement;
    }
    original(text, font);
}

