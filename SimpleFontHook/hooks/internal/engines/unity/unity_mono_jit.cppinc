static bool MonoRepairCatTextStyle(void* gameObject) {
    if (!gameObject || !MonoIsReplacementEnabled() ||
        InterlockedCompareExchange(&g_monoFontReady, 0, 0) == 0 ||
        !g_monoApi.gcHandleGetTarget || !g_monoBindings.catGetTextMeshPro)
        return false;
    void* fontAsset = g_monoReplacementFontAssetHandle
        ? g_monoApi.gcHandleGetTarget(g_monoReplacementFontAssetHandle) : NULL;
    void* material = g_monoReplacementMaterialHandle
        ? g_monoApi.gcHandleGetTarget(g_monoReplacementMaterialHandle) : NULL;
    void* text = NULL;
    bool gotText = fontAsset && material &&
        MonoInvoke(g_monoBindings.catGetTextMeshPro, gameObject, NULL, &text,
            "TextMeshProTextGameObject.get_textMeshPro(style-repair)");
    bool repaired = gotText && text &&
        MonoApplyTmpObjectImmediately(text, fontAsset, material);
    if (repaired && InterlockedExchange(&g_monoCatStyleRepairLogged, 1) == 0) {
        Utils::Trace("[DEBUG][UnityMono] CatSystem TMP material style repaired before render object=%p text=%p",
            gameObject, text);
    }
    return repaired;
}

static void __cdecl MonoNewCatInitializeMaterialJit(void* gameObject) {
    pMonoManagedObjectAction original = g_monoOriginalCatInitializeMaterialJit;
    if (!original) return;
    original(gameObject);
    if (g_monoCatSetFontJitActive || g_monoCatInitializeMaterialJitGuard)
        return;
    g_monoCatInitializeMaterialJitGuard = true;
    MonoRepairCatTextStyle(gameObject);
    g_monoCatInitializeMaterialJitGuard = false;
}

static void __cdecl MonoNewCatSetFontJit(void* gameObject, void* requestedFont) {
    pMonoManagedObjectSetter original = g_monoOriginalCatSetFontJit;
    if (!original) return;
    if (g_monoCatSetFontJitActive || !MonoIsReplacementEnabled() ||
        InterlockedCompareExchange(&g_monoFontReady, 0, 0) == 0) {
        original(gameObject, requestedFont);
        return;
    }

    // Let CatSystem build its original styled material first.  The TMP setter
    // detour is bypassed only inside this call; the replacement and atlas swap
    // are completed before SetFont returns to the game's render loop.
    g_monoCatSetFontJitActive = true;
    original(gameObject, requestedFont);
    g_monoCatSetFontJitActive = false;
    MonoRepairCatTextStyle(gameObject);
}

static bool MonoInstallCatSetFontJitHook() {
    LONG state = InterlockedCompareExchange(&g_monoCatSetFontJitHookState, 0, 0);
    if (state == 1) return true;
    if (state != 0 || !g_monoApi.compileMethod || !g_monoBindings.catSetFont ||
        !g_monoBindings.catGetTextMeshPro) return false;
    if (InterlockedCompareExchange(&g_monoCatSetFontJitHookState, -1, 0) != 0)
        return false;

    void* entry = g_monoApi.compileMethod(g_monoBindings.catSetFont);
    if (!MonoIsExecutableAddress(entry)) {
        Utils::Trace("[DEBUG][UnityMono] CatSystem SetFont JIT hook rejected entry=%p",
            entry);
        InterlockedExchange(&g_monoCatSetFontJitHookState, 0);
        return false;
    }
    g_monoOriginalCatSetFontJit = reinterpret_cast<pMonoManagedObjectSetter>(entry);
