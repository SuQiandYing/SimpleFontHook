    if (begin != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] CatSystem SetFont JIT transaction begin failed=%ld",
            begin);
        g_monoOriginalCatSetFontJit = NULL;
        InterlockedExchange(&g_monoCatSetFontJitHookState, 0);
        return false;
    }
    DetourUpdateThread(GetCurrentThread());
    LONG attach = DetourAttach(&(PVOID&)g_monoOriginalCatSetFontJit,
        MonoNewCatSetFontJit);
    LONG commit = attach == NO_ERROR ? DetourTransactionCommit()
        : DetourTransactionAbort();
    if (attach != NO_ERROR || commit != NO_ERROR) {
        Utils::Trace("[DEBUG][UnityMono] CatSystem SetFont JIT hook failed attach=%ld commit=%ld",
            attach, commit);
        g_monoOriginalCatSetFontJit = NULL;
        InterlockedExchange(&g_monoCatSetFontJitHookState, 0);
        return false;
    }
    InterlockedExchange(&g_monoCatSetFontJitHookState, 1);
    Utils::Trace("[DEBUG][UnityMono] CatSystem SetFont JIT hook attached target=%p trampoline=%p",
        entry, g_monoOriginalCatSetFontJit);
    return true;
}

