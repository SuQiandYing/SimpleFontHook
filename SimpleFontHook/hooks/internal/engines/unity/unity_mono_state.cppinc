struct MonoGlyphMutationGuard {
    bool acquired;

    MonoGlyphMutationGuard()
        : acquired(InterlockedCompareExchange(
            &g_monoGlyphMutationActive, 1, 0) == 0) {}
    ~MonoGlyphMutationGuard() {
        if (acquired) InterlockedExchange(&g_monoGlyphMutationActive, 0);
    }
};

