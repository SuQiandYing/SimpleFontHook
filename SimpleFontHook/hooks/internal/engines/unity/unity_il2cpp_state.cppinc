    pInternalCreateDynamicFont internalCreateDynamicFont;
    pInternalCreateFontFromPath internalCreateFontFromPath;
    pFontGetDynamic getFontDynamic;
    const void* createTmpFontAsset;
    const void* createTmpFontAssetDetailed;
    const void* getAtlasTexture;
    const void* getAssetMaterial;
    const void* setAssetMaterial;
    const void* assetMaterialField;
    const void* materialCopyConstructor;
    const void* getMaterialMainTexture;
    const void* setMaterialMainTexture;
    const void* getMaterialShader;
    const void* setMultiAtlasEnabled;
    const void* getAssetFallbacks;
    const void* findAllObjects;
    const void* getTextFont;
    const void* setTextFont;
    const void* setTextSharedMaterial;
    const void* forceMeshUpdate;
    const void* getGlobalFallbacks;
    void* tmpTextTypeObject;
    void* tmpFontAssetTypeObject;
    uint32_t tmpTextTypeHandle;
    uint32_t tmpFontAssetTypeHandle;
};

typedef LRESULT(WINAPI* pDispatchMessageW)(const MSG* message);
typedef BOOL(WINAPI* pShowWindow)(HWND window, int command);
typedef BOOL(WINAPI* pSetWindowPos)(HWND window, HWND insertAfter, int x, int y,
    int width, int height, UINT flags);
typedef void(__cdecl* pTmpTextObjectSetter)(void* text, void* value,
    const void* methodInfo);

static bool IsUnityWindow(HWND window);
static void RevealUnityWindow();

