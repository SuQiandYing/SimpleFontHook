// JavaScript bridges keep the selected font synchronized in Electron's main
// and renderer processes without restarting the game.

static const char kTyranoFontBridgeMarker[] = "SimpleFontHookTyranoFontBridgeV2";
static const char kTyranoFontBridge[] = R"SFH(
// SimpleFontHookTyranoFontBridgeV2
(() => {
  try {
    const electron = require("electron");
    const fs = require("fs");
    const path = require("path");
    const iniPath = path.join(path.dirname(process.execPath), "FontHook.ini");
    const cssKeys = new Map();
    let lastFamilies = "";
    let timer = 0;

    const readFamilies = () => {
      try {
        const text = fs.readFileSync(iniPath, "utf8").replace(/^\uFEFF/, "");
        const readValue = (key) => {
          const match = new RegExp(`^${key}=(.*)$`, "m").exec(text);
          return match ? match[1].trim() : "";
        };
        const families = [];
        const add = (family) => {
          if (family && !families.includes(family)) families.push(family);
        };
        [readValue("FontNameW"), readValue("FontNameA")].forEach((family) => {
          add(family);
          add(family.replace(/[ -]?\d{2,3}W(?:\s+\w+)?$/i, "").trim());
        });
        return families;
      } catch (_) {
        return [];
      }
    };

    const applyToWindow = (win, families) => {
      if (!win || win.isDestroyed() || !families.length) return;
      const oldKey = cssKeys.get(win.id);
      const remove = oldKey
        ? win.webContents.removeInsertedCSS(oldKey).catch(() => {})
        : Promise.resolve();
      remove.then(() => {
        if (win.isDestroyed()) return;
        const familyList = families.map(JSON.stringify).join(", ");
        return win.webContents.insertCSS(
          `html, body, body * { font-family: ${familyList}, sans-serif !important; }`,
          { cssOrigin: "user" }
        );
      }).then((key) => {
        if (key) cssKeys.set(win.id, key);
      }).catch(() => {});
    };

    const applyToAll = () => {
      const families = readFamilies();
      if (!families.length) return;
      lastFamilies = families.join("\n");
      electron.BrowserWindow.getAllWindows().forEach((win) => applyToWindow(win, families));
    };

    electron.app.on("browser-window-created", (_, win) => {
      win.webContents.on("did-finish-load", () => {
        cssKeys.delete(win.id);
        applyToWindow(win, readFamilies());
      });
      win.on("closed", () => cssKeys.delete(win.id));
    });

    electron.app.whenReady().then(applyToAll);
    fs.watchFile(iniPath, { interval: 200 }, () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const families = readFamilies();
        if (families.length && families.join("\n") !== lastFamilies) applyToAll();
      }, 80);
    });
    electron.app.on("will-quit", () => fs.unwatchFile(iniPath));
  } catch (_) {
    // The bridge is optional; the native web-font redirect remains available.
  }
})();
)SFH";

static const char kTyranoRendererFontBridgeMarker[] =
    "SimpleFontHookTyranoRendererFontBridgeV2";
static const char kTyranoRendererFontBridge[] = R"SFH(
// SimpleFontHookTyranoRendererFontBridgeV2
(() => {
  try {
    if (window.__simpleFontHookTyranoRendererBridgeV2) return;
    window.__simpleFontHookTyranoRendererBridgeV2 = true;

    const api = window.studio_api || {};
    const nodeRequire = typeof require === "function" ? require : null;
    const fs = api.fs_default || (nodeRequire ? nodeRequire("fs") : null);
    const path = api.path || (nodeRequire ? nodeRequire("path") : null);
    let execPath = window.process && window.process.execPath;
    if (!execPath && api.ipcRenderer) {
      const processInfo = api.ipcRenderer.sendSync("getProcess");
      execPath = processInfo && processInfo.execPath;
    }
    if (!fs || !path || !execPath) return;

    const iniPath = path.join(path.dirname(execPath), "FontHook.ini");
    const style = document.createElement("style");
    style.id = "simple-font-hook-tyrano-font";
    (document.head || document.documentElement).appendChild(style);
    let lastFamilies = "";

    const readFamilies = () => {
      try {
        const text = fs.readFileSync(iniPath, "utf8").replace(/^\uFEFF/, "");
        const readValue = (key) => {
          const match = new RegExp(`^${key}=(.*)$`, "m").exec(text);
          return match ? match[1].trim() : "";
        };
        const families = [];
        const add = (family) => {
          if (family && !families.includes(family)) families.push(family);
        };
        [readValue("FontNameW"), readValue("FontNameA")].forEach((family) => {
          add(family);
          add(family.replace(/[ -]?\d{2,3}W(?:\s+\w+)?$/i, "").trim());
        });
        return families;
      } catch (_) {
        return [];
      }
    };

    const apply = () => {
      const families = readFamilies();
      const familyKey = families.join("\n");
      if (!families.length || familyKey === lastFamilies) return;
      lastFamilies = familyKey;
      const familyList = families.map(JSON.stringify).join(", ");
      style.textContent =
        `html, body, body * { font-family: ${familyList}, sans-serif !important; }`;
      document.documentElement.dataset.simpleFontHookFace = families[0];
    };

    apply();
    const timer = window.setInterval(apply, 200);
    window.addEventListener("beforeunload", () => window.clearInterval(timer),
      { once: true });
  } catch (_) {
    // The native web-font redirect remains the fallback when preload APIs differ.
  }
})();
)SFH";

// Pure-ASAR games never open the loose main.js/tyrano.js paths handled above.
// Keep this payload below the reserved comment slot used by the ASAR read hook;
// replacing that slot preserves every archive entry offset and size.
static const char kTyranoAsarRendererBridgeSlotPrefix[] =
    "/*\r\n    $.setStorage = function(key,val){";
static const char kTyranoAsarRendererBridge[] = R"SFH(
(()=>{try{if(window.__sfh2)return;window.__sfh2=1;let r=typeof require=="function"&&require("fs"),p=typeof require=="function"&&require("path"),e=window.process&&window.process.execPath,s=document.createElement("style"),v="";if(!r||!p||!e)return;(document.head||document.documentElement).appendChild(s);let a=()=>{try{let m=/^FontNameW=(.*)$/m.exec(r.readFileSync(p.join(p.dirname(e),"FontHook.ini"),"utf8")),n=m&&m[1].trim();if(n&&n!=v)v=n,s.textContent="html,body,body *{font-family:"+JSON.stringify(n)+","+JSON.stringify(n.replace(/[ -]?\d{2,3}W.*$/i,""))+",sans-serif!important}"}catch(_){}};a();setInterval(a,200)}catch(_){}})();
)SFH";

static const char* TyranoBridgePayloadForPath(const std::wstring& relativePath) {
    if (relativePath == L"main.js") return kTyranoFontBridge;
    if (relativePath == L"tyrano\\tyrano.js") return kTyranoRendererFontBridge;
    return nullptr;
}

static const char* TyranoBridgeMarkerForPath(const std::wstring& relativePath) {
    if (relativePath == L"main.js") return kTyranoFontBridgeMarker;
    if (relativePath == L"tyrano\\tyrano.js") return kTyranoRendererFontBridgeMarker;
    return nullptr;
}
