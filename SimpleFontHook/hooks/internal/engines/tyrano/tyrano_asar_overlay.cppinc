// ASAR indexing and loose resources/app overlay used when Electron prefers the
// archive over the extracted fallback tree.

static bool TyranoReadAt(HANDLE file, ULONGLONG offset, void* buffer, DWORD size) {
    if (!file || file == INVALID_HANDLE_VALUE || (!buffer && size != 0)) return false;
    LARGE_INTEGER position = {};
    position.QuadPart = (LONGLONG)offset;
    if (!SetFilePointerEx(file, position, NULL, FILE_BEGIN)) return false;

    BYTE* out = (BYTE*)buffer;
    DWORD remaining = size;
    while (remaining != 0) {
        DWORD read = 0;
        if (!ReadFile(file, out, remaining, &read, NULL) || read == 0) return false;
        out += read;
        remaining -= read;
    }
    return true;
}

static bool TyranoEnsureAsarIndex() {
    std::wstring asarPath = TyranoBuildRootPath(L"resources\\app.asar");
    DWORD now = GetTickCount();
    {
        std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
        if (g_tyranoAsarIndexAttempted &&
            g_tyranoAsarIndexPath == asarPath &&
            now - g_tyranoAsarLastValidationTick < 1000) {
            return !g_tyranoAsarEntries.empty();
        }
    }

    HANDLE file = orgCreateFileW(asarPath.c_str(), GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);
    if (file == INVALID_HANDLE_VALUE) return false;

    LARGE_INTEGER fileSize = {};
    if (!GetFileSizeEx(file, &fileSize) || fileSize.QuadPart < 32) {
        CloseHandle(file);
        return false;
    }

    std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
    if (g_tyranoAsarIndexAttempted && g_tyranoAsarIndexPath == asarPath &&
        g_tyranoAsarIndexFileSize == (ULONGLONG)fileSize.QuadPart) {
        g_tyranoAsarLastValidationTick = now;
        CloseHandle(file);
        return !g_tyranoAsarEntries.empty();
    }

    g_tyranoAsarIndexAttempted = true;
    g_tyranoAsarIndexPath = asarPath;
    g_tyranoAsarIndexFileSize = (ULONGLONG)fileSize.QuadPart;
    g_tyranoAsarDataOffset = 0;
    g_tyranoAsarLastValidationTick = now;
    g_tyranoAsarEntries.clear();

    DWORD headerWords[4] = {};
    if (!TyranoReadAt(file, 0, headerWords, sizeof(headerWords))) {
        CloseHandle(file);
        return false;
    }

    // ASAR uses two Chromium Pickle records. The archive payload starts at
    // 8 + headerWords[1], while headerWords[3] is the UTF-8 JSON byte count.
    ULONGLONG dataOffset = 8ULL + headerWords[1];
    DWORD jsonSize = headerWords[3];
    bool headerLooksValid = headerWords[0] == 4 && jsonSize >= 2 &&
        jsonSize <= 64U * 1024U * 1024U && dataOffset > 16 &&
        dataOffset <= (ULONGLONG)fileSize.QuadPart &&
        16ULL + jsonSize <= dataOffset;
    if (!headerLooksValid) {
        TyranoTraceLimited("asar-index-failed reason=header words=%lu,%lu,%lu,%lu size=%llu",
            headerWords[0], headerWords[1], headerWords[2], headerWords[3],
            (unsigned long long)fileSize.QuadPart);
        CloseHandle(file);
        return false;
    }

    std::vector<char> json((size_t)jsonSize + 1, '\0');
    if (!TyranoReadAt(file, 16, json.data(), jsonSize)) {
        CloseHandle(file);
        return false;
    }
    CloseHandle(file);

    TyranoAsarJsonParser parser(json.data(), jsonSize);
    if (!parser.Parse(g_tyranoAsarEntries, dataOffset) || g_tyranoAsarEntries.empty()) {
        TyranoTraceLimited("asar-index-failed reason=json bytes=%lu", jsonSize);
        g_tyranoAsarEntries.clear();
        return false;
    }

    g_tyranoAsarDataOffset = dataOffset;
    TyranoTraceLimited("asar-index-ready entries=%lu data-offset=%llu archive='%s'",
        (DWORD)g_tyranoAsarEntries.size(), (unsigned long long)dataOffset,
        EngineCommon::WideToUtf8(asarPath).c_str());
    return true;
}

static bool TyranoLoosePathToRelative(const wchar_t* fileName,
    std::wstring* fullPathOut, std::wstring* relativePathOut) {
    if (!fileName || !fileName[0]) return false;

    std::wstring fullPath = EngineCommon::FullPath(fileName);
    std::wstring normalized = EngineCommon::NormalizePath(fullPath);
    std::wstring appRoot = EngineCommon::NormalizePath(TyranoBuildRootPath(L"resources\\app"));
    if (appRoot.empty() || normalized.size() < appRoot.size() ||
        normalized.compare(0, appRoot.size(), appRoot) != 0 ||
        (normalized.size() > appRoot.size() &&
         normalized[appRoot.size()] != L'\\')) {
        return false;
    }

    std::wstring relative;
    if (normalized.size() > appRoot.size()) {
        relative = TyranoNormalizeRelativePath(
            normalized.substr(appRoot.size() + 1));
    }
    if (normalized.size() > appRoot.size() && relative.empty()) {
        return false;
    }

    if (fullPathOut) *fullPathOut = fullPath;
    if (relativePathOut) *relativePathOut = relative;
    return true;
}

static bool TyranoAsarIsDirectory(const std::wstring& relativePath) {
    if (!TyranoEnsureAsarIndex()) return false;
    std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
    if (relativePath.empty()) return true;
    std::wstring prefix = relativePath;
    if (prefix.back() != L'\\') prefix += L'\\';
    for (const auto& pair : g_tyranoAsarEntries) {
        if (pair.first.rfind(prefix, 0) == 0) {
            return true;
        }
    }
    return false;
}

static bool TyranoFindAsarEntryForLoosePath(const wchar_t* fileName,
    std::wstring* fullPathOut, std::wstring* relativePathOut,
    TyranoAsarEntry* entryOut) {
    std::wstring fullPath;
    std::wstring relativePath;
    if (!TyranoLoosePathToRelative(fileName, &fullPath, &relativePath) ||
        !TyranoEnsureAsarIndex()) {
        return false;
    }

    std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
    auto found = g_tyranoAsarEntries.find(relativePath);
    if (found == g_tyranoAsarEntries.end() || found->second.unpacked) return false;
    if (fullPathOut) *fullPathOut = fullPath;
    if (relativePathOut) *relativePathOut = relativePath;
    if (entryOut) *entryOut = found->second;
    return true;
}

static bool TyranoIsTextAsarEntry(const std::wstring& path) {
    const wchar_t* extensions[] = {
        L".ks", L".tjs", L".js", L".mjs", L".cjs", L".json",
        L".html", L".htm", L".css", L".txt", L".csv", L".xml",
        L".ini", L".yaml", L".yml"
    };
    for (const wchar_t* extension : extensions) {
        if (EngineCommon::HasExtension(path, extension)) return true;
    }
    return false;
}

static bool TyranoShouldOverlayAsarEntry(const std::wstring& fullPath,
    const std::wstring& relativePath, const TyranoAsarEntry& entry) {
    if (entry.size > 64ULL * 1024ULL * 1024ULL) return false;
    if (relativePath == L"main.js" || TyranoIsTextAsarEntry(relativePath)) return true;

    // Missing or size-mismatched loose assets also come from the archive. This
    // preserves localized UI images without forcing large audio/video streams
    // through temporary files.
    HANDLE loose = orgCreateFileW(fullPath.c_str(), GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (loose == INVALID_HANDLE_VALUE) return true;
    LARGE_INTEGER looseSize = {};
    bool mismatch = !GetFileSizeEx(loose, &looseSize) ||
        (ULONGLONG)looseSize.QuadPart != entry.size;
    CloseHandle(loose);
    return mismatch;
}

static bool TyranoReadAsarEntry(const TyranoAsarEntry& entry,
    std::vector<BYTE>& bytes) {
    bytes.clear();
    if (entry.unpacked || entry.size > 64ULL * 1024ULL * 1024ULL ||
        entry.size > MAXDWORD || !TyranoEnsureAsarIndex()) {
        return false;
    }

    std::wstring asarPath;
    ULONGLONG archiveSize = 0;
    {
        std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
        asarPath = g_tyranoAsarIndexPath;
        archiveSize = g_tyranoAsarIndexFileSize;
    }
    if (entry.absoluteOffset > archiveSize || entry.size > archiveSize - entry.absoluteOffset)
        return false;

    HANDLE file = orgCreateFileW(asarPath.c_str(), GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_RANDOM_ACCESS, NULL);
    if (file == INVALID_HANDLE_VALUE) return false;

    bytes.resize((size_t)entry.size);
    bool ok = entry.size == 0 ||
        TyranoReadAt(file, entry.absoluteOffset, bytes.data(), (DWORD)entry.size);
    CloseHandle(file);
    if (!ok) bytes.clear();
    return ok;
}

static bool TyranoGetAsarEntry(const wchar_t* relativePath,
    TyranoAsarEntry* entryOut) {
    if (!relativePath || !relativePath[0] || !entryOut ||
        !TyranoEnsureAsarIndex()) {
        return false;
    }
    std::wstring normalized = TyranoNormalizeRelativePath(relativePath);
    if (normalized.empty()) return false;
    std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
    auto found = g_tyranoAsarEntries.find(normalized);
    if (found == g_tyranoAsarEntries.end() || found->second.unpacked) return false;
    *entryOut = found->second;
    return true;
}

static bool TyranoPrepareAsarRendererPatch() {
    std::lock_guard<std::mutex> lock(g_tyranoScriptPatchMutex);
    if (g_tyranoScriptPatchPrepared) return !g_tyranoScriptPatchBytes.empty();
    g_tyranoScriptPatchPrepared = true;

    TyranoAsarEntry entry = {};
    std::vector<BYTE> entryBytes;
    if (!TyranoGetAsarEntry(L"tyrano\\libs.js", &entry) || entry.size == 0 ||
        !TyranoReadAsarEntry(entry, entryBytes)) {
        TyranoTraceLimited("asar-script-plan-failed entry='tyrano/libs.js' reason=read");
        return false;
    }

    size_t bridgeLength = strlen(kTyranoAsarRendererBridge);
    size_t prefixLength = strlen(kTyranoAsarRendererBridgeSlotPrefix);
    BYTE* entryBegin = entryBytes.data();
    BYTE* entryEnd = entryBegin + entryBytes.size();
    BYTE* slotBegin = std::search(entryBegin, entryEnd,
        kTyranoAsarRendererBridgeSlotPrefix,
        kTyranoAsarRendererBridgeSlotPrefix + prefixLength);
    if (slotBegin == entryEnd) {
        TyranoTraceLimited("asar-script-plan-failed entry='tyrano/libs.js' reason=slot-prefix");
        return false;
    }

    static const char kCommentEnd[] = "*/";
    BYTE* slotEndMarker = std::search(slotBegin + prefixLength, entryEnd,
        kCommentEnd, kCommentEnd + 2);
    if (slotEndMarker == entryEnd) {
        TyranoTraceLimited("asar-script-plan-failed entry='tyrano/libs.js' reason=slot-end");
        return false;
    }

    size_t slotLength = static_cast<size_t>(slotEndMarker + 2 - slotBegin);
    if (bridgeLength == 0 || bridgeLength > slotLength) {
        TyranoTraceLimited("asar-script-plan-failed entry='tyrano/libs.js' bridge=%lu slot=%lu",
            (DWORD)bridgeLength, (DWORD)slotLength);
        return false;
    }

    size_t slotRelativeOffset = static_cast<size_t>(slotBegin - entryBegin);
    if (entry.absoluteOffset > ULLONG_MAX - slotRelativeOffset) return false;
    g_tyranoScriptPatchOffset = entry.absoluteOffset + slotRelativeOffset;
    g_tyranoScriptPatchBytes.assign(slotLength, static_cast<BYTE>(' '));
    memcpy(g_tyranoScriptPatchBytes.data(), kTyranoAsarRendererBridge,
        bridgeLength);
    TyranoTraceLimited("asar-script-plan-ready entry='tyrano/libs.js' offset=%llu bridge=%lu slot=%lu",
        (unsigned long long)g_tyranoScriptPatchOffset, (DWORD)bridgeLength,
        (DWORD)slotLength);
    return true;
}

static bool TyranoPatchAsarRendererScript(HANDLE file, void* buffer,
    DWORD bytesRead, ULONGLONG readStart) {
    if (!buffer || bytesRead == 0 || !TyranoReplacementEnabled()) return false;

    if (!TyranoPrepareAsarRendererPatch()) return false;
    ULONGLONG readEnd = readStart + bytesRead;
    if (readEnd < readStart) return false;

    std::wstring asarPath = TyranoBuildRootPath(L"resources\\app.asar");
    wchar_t finalPath[MAX_PATH] = {};
    DWORD finalLength = GetFinalPathNameByHandleW(file, finalPath,
        _countof(finalPath), FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
    if (finalLength == 0 || finalLength >= _countof(finalPath)) return false;
    const wchar_t* comparablePath = finalPath;
    if (wcsncmp(comparablePath, L"\\\\?\\", 4) == 0) comparablePath += 4;
    if (!EngineCommon::SamePath(comparablePath, asarPath)) return false;

    std::lock_guard<std::mutex> patchLock(g_tyranoScriptPatchMutex);
    ULONGLONG patchEnd = g_tyranoScriptPatchOffset +
        static_cast<ULONGLONG>(g_tyranoScriptPatchBytes.size());
    if (patchEnd < g_tyranoScriptPatchOffset ||
        readEnd <= g_tyranoScriptPatchOffset || readStart >= patchEnd) {
        return false;
    }

    ULONGLONG copyStart = (std::max)(readStart, g_tyranoScriptPatchOffset);
    ULONGLONG copyEnd = (std::min)(readEnd, patchEnd);
    size_t sourceOffset = static_cast<size_t>(copyStart - g_tyranoScriptPatchOffset);
    size_t destinationOffset = static_cast<size_t>(copyStart - readStart);
    size_t copyLength = static_cast<size_t>(copyEnd - copyStart);
    memcpy(static_cast<BYTE*>(buffer) + destinationOffset,
        g_tyranoScriptPatchBytes.data() + sourceOffset, copyLength);
    LONG hit = InterlockedIncrement(&g_tyranoScriptPatchCount);
    TyranoTraceLimited("asar-script-patched entry='tyrano/libs.js' offset=%llu fragment=%lu hit=%ld",
        (unsigned long long)copyStart, (DWORD)copyLength, hit);
    return true;
}

static bool TyranoReadFileStamp(const std::wstring& path, FILETIME* creation,
    FILETIME* access, FILETIME* write, ULONGLONG* sizeOut) {
    HANDLE file = orgCreateFileW(path.c_str(), GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (file == INVALID_HANDLE_VALUE) return false;
    LARGE_INTEGER size = {};
    FILETIME localCreation = {}, localAccess = {}, localWrite = {};
    bool ok = GetFileSizeEx(file, &size) &&
        GetFileTime(file, &localCreation, &localAccess, &localWrite);
    CloseHandle(file);
    if (!ok || size.QuadPart < 0) return false;
    if (creation) *creation = localCreation;
    if (access) *access = localAccess;
    if (write) *write = localWrite;
    if (sizeOut) *sizeOut = static_cast<ULONGLONG>(size.QuadPart);
    return true;
}

static bool TyranoPatchedAsarIsCurrent(const std::wstring& source,
    const std::wstring& cache) {
    FILETIME sourceCreation = {}, sourceAccess = {}, sourceWrite = {};
    FILETIME cacheCreation = {}, cacheAccess = {}, cacheWrite = {};
    ULONGLONG sourceSize = 0, cacheSize = 0;
    if (!TyranoReadFileStamp(source, &sourceCreation, &sourceAccess,
        &sourceWrite, &sourceSize) ||
        !TyranoReadFileStamp(cache, &cacheCreation, &cacheAccess,
            &cacheWrite, &cacheSize)) {
        return false;
    }
    if (sourceSize != cacheSize || CompareFileTime(&sourceWrite, &cacheWrite) != 0)
        return false;

    // Source timestamps stay unchanged when a newer DLL changes the injected
    // bridge. Include the reserved slot bytes in the persistent cache identity.
    if (!TyranoPrepareAsarRendererPatch()) return false;
    ULONGLONG patchOffset = 0;
    std::vector<BYTE> expected;
    {
        std::lock_guard<std::mutex> patchLock(g_tyranoScriptPatchMutex);
        patchOffset = g_tyranoScriptPatchOffset;
        expected = g_tyranoScriptPatchBytes;
    }
    if (expected.empty() || expected.size() > MAXDWORD) return false;

    HANDLE cacheFile = orgCreateFileW(cache.c_str(), GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (cacheFile == INVALID_HANDLE_VALUE) return false;
    std::vector<BYTE> actual(expected.size());
    bool matches = TyranoReadAt(cacheFile, patchOffset, actual.data(),
        (DWORD)actual.size()) && actual == expected;
    CloseHandle(cacheFile);
    return matches;
}

static bool TyranoEnsurePatchedAsar(std::wstring* cachePathOut) {
    std::wstring source = TyranoBuildRootPath(L"resources\\app.asar");
    std::wstring cache = TyranoBuildRootPath(L"resources\\app.asar.sfh");
    std::lock_guard<std::mutex> lock(g_tyranoPatchedAsarMutex);
    if (g_tyranoPatchedAsarAttempted && g_tyranoPatchedAsarPath == source) {
        if (cachePathOut && PathFileExistsW(cache.c_str())) *cachePathOut = cache;
        return PathFileExistsW(cache.c_str());
    }
    g_tyranoPatchedAsarAttempted = true;
    g_tyranoPatchedAsarPath = source;
    if (!TyranoReplacementEnabled() || !PathFileExistsW(source.c_str())) return false;

    if (!TyranoPatchedAsarIsCurrent(source, cache)) {
        if (!CopyFileW(source.c_str(), cache.c_str(), FALSE)) {
            TyranoTraceLimited("asar-cache-copy-failed source='%s' cache='%s' err=%lu",
                EngineCommon::WideToUtf8(source).c_str(),
                EngineCommon::WideToUtf8(cache).c_str(), GetLastError());
            return false;
        }
        if (!TyranoPrepareAsarRendererPatch()) {
            DeleteFileW(cache.c_str());
            return false;
        }

        std::lock_guard<std::mutex> patchLock(g_tyranoScriptPatchMutex);
        HANDLE cacheFile = orgCreateFileW(cache.c_str(), GENERIC_WRITE,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (cacheFile == INVALID_HANDLE_VALUE) {
            DeleteFileW(cache.c_str());
            return false;
        }
        LARGE_INTEGER position = {};
        position.QuadPart = static_cast<LONGLONG>(g_tyranoScriptPatchOffset);
        bool ok = SetFilePointerEx(cacheFile, position, NULL, FILE_BEGIN);
        DWORD written = 0;
        if (ok && !g_tyranoScriptPatchBytes.empty()) {
            ok = WriteFile(cacheFile, g_tyranoScriptPatchBytes.data(),
                (DWORD)g_tyranoScriptPatchBytes.size(), &written, NULL) != FALSE &&
                written == g_tyranoScriptPatchBytes.size();
        }
        FlushFileBuffers(cacheFile);
        CloseHandle(cacheFile);
        if (!ok) {
            DeleteFileW(cache.c_str());
            TyranoTraceLimited("asar-cache-patch-failed cache='%s' err=%lu",
                EngineCommon::WideToUtf8(cache).c_str(), GetLastError());
            return false;
        }

        HANDLE sourceFile = orgCreateFileW(source.c_str(), GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        HANDLE patchedFile = orgCreateFileW(cache.c_str(), FILE_WRITE_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (sourceFile != INVALID_HANDLE_VALUE && patchedFile != INVALID_HANDLE_VALUE) {
            FILETIME creation = {}, access = {}, write = {};
            if (GetFileTime(sourceFile, &creation, &access, &write)) {
                SetFileTime(patchedFile, &creation, &access, &write);
            }
        }
        if (sourceFile != INVALID_HANDLE_VALUE) CloseHandle(sourceFile);
        if (patchedFile != INVALID_HANDLE_VALUE) CloseHandle(patchedFile);
        TyranoTraceLimited("asar-cache-ready source='%s' cache='%s' offset=%llu bytes=%lu",
            EngineCommon::WideToUtf8(source).c_str(),
            EngineCommon::WideToUtf8(cache).c_str(),
            (unsigned long long)g_tyranoScriptPatchOffset,
            (DWORD)g_tyranoScriptPatchBytes.size());
    }

    if (cachePathOut) *cachePathOut = cache;
    return PathFileExistsW(cache.c_str()) != FALSE;
}

static HANDLE TyranoTryOpenPatchedAsarW(const wchar_t* fileName,
    DWORD desiredAccess, DWORD creationDisposition) {
    if (!EngineCommon::IsReadOnlyOpen(desiredAccess, creationDisposition) ||
        !fileName || !fileName[0]) return INVALID_HANDLE_VALUE;
    std::wstring requested = EngineCommon::FullPath(fileName);
    std::wstring source = TyranoBuildRootPath(L"resources\\app.asar");
    if (!EngineCommon::SamePath(requested, source)) return INVALID_HANDLE_VALUE;
    std::wstring cache;
    if (!TyranoEnsurePatchedAsar(&cache)) return INVALID_HANDLE_VALUE;
    HANDLE file = orgCreateFileW(cache.c_str(), desiredAccess,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (file != INVALID_HANDLE_VALUE) {
        TyranoTraceLimited("asar-cache-open request='%s' cache='%s'",
            EngineCommon::WideToUtf8(requested).c_str(),
            EngineCommon::WideToUtf8(cache).c_str());
    }
    return file;
}

static bool TyranoBytesContain(const std::vector<BYTE>& bytes, const char* needle) {
    if (!needle || !needle[0] || bytes.empty()) return false;
    size_t needleLength = strlen(needle);
    if (needleLength > bytes.size()) return false;
    return std::search(bytes.begin(), bytes.end(), needle, needle + needleLength) != bytes.end();
}

static bool TyranoPrepareAsarOverlay(const wchar_t* fileName,
    std::wstring* fullPathOut, std::wstring* relativePathOut,
    TyranoAsarEntry* entryOut, bool* injectBridgeOut) {
    std::wstring fullPath;
    std::wstring relativePath;
    if (!TyranoLoosePathToRelative(fileName, &fullPath, &relativePath)) return false;
    if (!TyranoReplacementEnabled()) return false;

    const char* bridgePayload = TyranoBridgePayloadForPath(relativePath);
    if (bridgePayload) {
        if (fullPathOut) *fullPathOut = fullPath;
        if (relativePathOut) *relativePathOut = relativePath;
        if (injectBridgeOut) *injectBridgeOut = true;
        TyranoAsarEntry entry = {};
        if (TyranoEnsureAsarIndex()) {
            std::lock_guard<std::mutex> lock(g_tyranoAsarMutex);
            auto found = g_tyranoAsarEntries.find(relativePath);
            if (found != g_tyranoAsarEntries.end() && !found->second.unpacked) {
                entry = found->second;
            }
        }
        if (entryOut) *entryOut = entry;
        return true;
    }

    TyranoAsarEntry entry = {};
    if (!TyranoFindAsarEntryForLoosePath(fileName, &fullPath, &relativePath, &entry) ||
        !TyranoShouldOverlayAsarEntry(fullPath, relativePath, entry)) {
        return false;
    }

    if (fullPathOut) *fullPathOut = fullPath;
    if (relativePathOut) *relativePathOut = relativePath;
    if (entryOut) *entryOut = entry;
    if (injectBridgeOut) *injectBridgeOut = false;
    return true;
}

static bool TyranoReadAsarOverlayBytes(const wchar_t* fileName,
    std::vector<BYTE>& bytes, std::wstring* fullPathOut,
    std::wstring* relativePathOut) {
    bytes.clear();
    TyranoAsarEntry entry = {};
    bool injectBridge = false;
    std::wstring fullPath;
    std::wstring relativePath;
    if (!TyranoPrepareAsarOverlay(fileName, &fullPath, &relativePath,
        &entry, &injectBridge)) {
        return false;
    }

    bool readOk = false;
    if (entry.size > 0 || entry.absoluteOffset > 0) {
        readOk = TyranoReadAsarEntry(entry, bytes);
    }

    if (!readOk) {
        // Loose file fallback on disk (e.g. loose main.js).
        HANDLE looseFile = orgCreateFileW(fullPath.c_str(), GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (looseFile != INVALID_HANDLE_VALUE) {
            LARGE_INTEGER looseSize = {};
            if (GetFileSizeEx(looseFile, &looseSize) && looseSize.QuadPart > 0 &&
                looseSize.QuadPart <= 64ULL * 1024ULL * 1024ULL) {
                bytes.resize((size_t)looseSize.QuadPart);
                DWORD readBytes = 0;
                if (ReadFile(looseFile, bytes.data(), (DWORD)looseSize.QuadPart, &readBytes, NULL) &&
                    readBytes == (DWORD)looseSize.QuadPart) {
                    readOk = true;
                }
            }
            CloseHandle(looseFile);
        }
    }

    if (!readOk) return false;

    const char* bridgePayload = injectBridge ?
        TyranoBridgePayloadForPath(relativePath) : nullptr;
    const char* bridgeMarker = injectBridge ?
        TyranoBridgeMarkerForPath(relativePath) : nullptr;
    if (bridgePayload && bridgeMarker && !TyranoBytesContain(bytes, bridgeMarker)) {
        const BYTE* bridge = (const BYTE*)bridgePayload;
        bytes.insert(bytes.end(), bridge, bridge + strlen(bridgePayload));
    }
    if (fullPathOut) *fullPathOut = fullPath;
    if (relativePathOut) *relativePathOut = relativePath;
    return true;
}

static HANDLE TyranoTryOpenAsarOverlayFileW(const wchar_t* fileName,
    DWORD desiredAccess, DWORD creationDisposition) {
    if (!EngineCommon::IsReadOnlyOpen(desiredAccess, creationDisposition))
        return INVALID_HANDLE_VALUE;

    std::vector<BYTE> bytes;
    std::wstring fullPath;
    std::wstring relativePath;
    if (!TyranoReadAsarOverlayBytes(fileName, bytes, &fullPath, &relativePath))
        return INVALID_HANDLE_VALUE;

    HANDLE file = EngineCommon::CreateTemporaryReadHandle(bytes.data(), bytes.size());
    if (file == INVALID_HANDLE_VALUE) {
        TyranoTraceLimited("asar-overlay-open-failed request='%s' entry='%s' err=%lu bytes=%lu",
            EngineCommon::WideToUtf8(fullPath).c_str(), EngineCommon::WideToUtf8(relativePath).c_str(),
            GetLastError(), (DWORD)bytes.size());
        return INVALID_HANDLE_VALUE;
    }

    TyranoTraceLimited("asar-overlay-open request='%s' entry='%s' bytes=%lu bridge=%d",
        EngineCommon::WideToUtf8(fullPath).c_str(), EngineCommon::WideToUtf8(relativePath).c_str(),
        (DWORD)bytes.size(), TyranoBridgePayloadForPath(relativePath) ? 1 : 0);
    return file;
}

static bool TyranoTryGetAsarOverlayAttributesW(const wchar_t* fileName,
    WIN32_FILE_ATTRIBUTE_DATA* data, DWORD* attrs) {
    std::wstring fullPath;
    std::wstring relativePath;
    if (!TyranoLoosePathToRelative(fileName, &fullPath, &relativePath)) return false;
    if (!TyranoReplacementEnabled()) return false;

    if (relativePath.empty() || TyranoAsarIsDirectory(relativePath)) {
        WIN32_FILE_ATTRIBUTE_DATA localData = {};
        localData.dwFileAttributes = FILE_ATTRIBUTE_DIRECTORY;
        GetSystemTimeAsFileTime(&localData.ftCreationTime);
        localData.ftLastAccessTime = localData.ftCreationTime;
        localData.ftLastWriteTime = localData.ftCreationTime;

        if (data) *data = localData;
        if (attrs) *attrs = localData.dwFileAttributes;
        return true;
    }

    TyranoAsarEntry entry = {};
    bool injectBridge = false;
    if (!TyranoPrepareAsarOverlay(fileName, &fullPath, &relativePath,
        &entry, &injectBridge)) {
        return false;
    }

    const char* bridgePayload = injectBridge ?
        TyranoBridgePayloadForPath(relativePath) : nullptr;
    ULONGLONG size = entry.size;
    if (bridgePayload && size == 0) {
        HANDLE looseFile = orgCreateFileW(fullPath.c_str(), GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (looseFile != INVALID_HANDLE_VALUE) {
            LARGE_INTEGER looseSize = {};
            if (GetFileSizeEx(looseFile, &looseSize) && looseSize.QuadPart >= 0) {
                size = (ULONGLONG)looseSize.QuadPart;
            }
            CloseHandle(looseFile);
        }
    }
    if (bridgePayload) size += strlen(bridgePayload);
    WIN32_FILE_ATTRIBUTE_DATA localData = {};
    localData.dwFileAttributes = FILE_ATTRIBUTE_NORMAL;
    localData.nFileSizeHigh = (DWORD)(size >> 32);
    localData.nFileSizeLow = (DWORD)size;
    GetSystemTimeAsFileTime(&localData.ftCreationTime);
    localData.ftLastAccessTime = localData.ftCreationTime;
    localData.ftLastWriteTime = localData.ftCreationTime;

    if (data) *data = localData;
    if (attrs) *attrs = localData.dwFileAttributes;
    return true;
}
