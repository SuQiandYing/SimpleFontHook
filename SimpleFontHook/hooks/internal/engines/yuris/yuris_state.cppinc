static std::vector<CatalogEntry> g_catalog;
static std::unordered_multimap<DWORD, int> g_catalogByCompressedSize;
static std::unordered_multimap<DWORD, YdgCatalogSectionRef>
    g_ydgBySectionSize;
static std::vector<AtlasSetState> g_atlasSets;
static const ArchiveProfile* g_archiveProfile = NULL;

static std::mutex g_renderCacheMutex;
static std::vector<RenderCacheEntry> g_renderCache;

static unsigned __int64 HashBytes(const void* bytes, size_t byteCount) {
    const BYTE* cursor = static_cast<const BYTE*>(bytes);
    unsigned __int64 hash = 14695981039346656037ULL;
    for (size_t index = 0; index < byteCount; ++index) {
        hash ^= cursor[index];
        hash *= 1099511628211ULL;
    }
    return hash;
}

static bool IsIdentityConfirmed() {
    LONG state = InterlockedCompareExchange(&g_identityState, 0, 0);
    if (state != 0) return state == 2;

    static const char* const markers[] = {
        "ysbin\\yscfg.ybn",
        "yu-ris1",
    };
    bool confirmed = EngineIdentityPolicy::Confirm({
        EngineCommon::MainModuleContainsAllAscii(markers, _countof(markers)),
        false,
        false,
        false,
        false,
    });
    InterlockedCompareExchange(&g_identityState, confirmed ? 2 : 1, 0);
    state = InterlockedCompareExchange(&g_identityState, 0, 0);
    if (state == 2) {
        Utils::Trace("[Yuris] identity confirmed markers=ysbin/yscfg.ybn+yu-ris1");
    }
    return state == 2;
}

} // namespace Yuris
