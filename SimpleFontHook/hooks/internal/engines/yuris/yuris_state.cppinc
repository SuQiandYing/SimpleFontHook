constexpr size_t kRenderCacheLimit = 12;

enum StyleFlag : unsigned char {
    StyleBold = 1,
    StyleShadow = 2,
    StyleOutline = 4,
};

enum class AtlasByteLayout : unsigned char {
    Dbcs188,
    LinearDbcs192WithAscii,
    SplitDbcs160,
    SplitDbcs160WithAscii,
};

enum class AtlasGlyphPlacement : unsigned char {
    TextOrigin,
    Big5OpticalCell,
    ReliriumOpticalCell,
};

enum class AtlasPixelOrder : unsigned char {
    Bgra,
    Rgba,
};

enum class AtlasPathKind : unsigned char {
    StyledDirectory,
    StyledSizeDirectory,
    NamedFontDirectory,
};

enum class AtlasDecoderKind : unsigned char {
    WebpOrdinal3,
    PngOrdinals1And2,
    MainModuleYdgSections,
};

struct MainModuleDecoderProfile {
    const char* name;
    const BYTE* signature;
    size_t signatureSize;
};

struct AtlasLayout {
    int width;
    int height;
    int originX;
    int originY;
    int cellWidth;
    int cellHeight;
    int drawOffsetX;
    int drawOffsetY;
    int glyphWidth;
    int glyphHeight;
    int columns;
    int rows;
    int fontPixels;
};

struct AtlasEncodingProfile {
    const char* name;
    AtlasByteLayout byteLayout;
    UINT preferredCodepage;
    BYTE privateUseLeadPageLimit;
    UINT32 invalidGlyph;
    bool useStandardBig5Symbols;
    bool applyTextSubstitution;
};

struct AtlasProfile {
    const char* name;
    DWORD pageCount;
    const unsigned char* styles;
    size_t styleCount;
    AtlasLayout layout;
    AtlasGlyphPlacement glyphPlacement;
    const AtlasEncodingProfile* encoding;
    AtlasPixelOrder pixelOrder;
    AtlasPathKind pathKind;
    const wchar_t* directoryName;
    const wchar_t* filePrefix;
    const wchar_t* fileExtension;
    bool forceOutline;
    const BYTE* pageNumbers;
    size_t pageNumberCount;
    BYTE outlineWidth;
    BYTE outlineRed;
    BYTE outlineGreen;
    BYTE outlineBlue;
    BYTE outlineAlpha;
};

struct ArchiveProfile {
    const char* name;
    const wchar_t* archiveHintPath;
    const wchar_t* decoderModule;
    const char* pathPrefix;
    const BYTE* nameLengthSwaps;
    size_t nameLengthSwapCount;
    DWORD ypfVersion;
    UINT preferredArchiveNameCodepage;
    BYTE fileType;
    AtlasDecoderKind decoderKind;
    const MainModuleDecoderProfile* mainModuleDecoder;
    const AtlasProfile* atlasProfiles;
    size_t atlasProfileCount;
    bool strictArchiveNameEncoding;
    bool fontOnlyArchive;
};

struct AtlasCharacterMapState {
    UINT codepage;
    std::vector<std::vector<UINT32>> pages;
};

struct AtlasSetState {
    const AtlasProfile* profile;
    UINT automaticCodepage;
    std::vector<AtlasCharacterMapState> characterMaps;
};

struct CatalogEntry {
    struct Section {
        unsigned __int64 fingerprint;
        DWORD compressedSize;
        int sourceRow;
        int sourceHeight;
    };

    unsigned __int64 fingerprint;
    DWORD compressedSize;
    int page;
    unsigned char style;
    int atlasSetIndex;
    std::vector<Section> sections;
};

struct YdgCatalogSectionRef {
    int catalogIndex;
    size_t sectionIndex;
};

struct RenderCacheEntry {
    LONG version;
    int catalogIndex;
    UINT characterCodepage;
    unsigned __int64 useSerial;
    std::vector<BYTE> pixels;
};

