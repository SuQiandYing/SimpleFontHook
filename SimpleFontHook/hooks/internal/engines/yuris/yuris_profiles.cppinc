static size_t AtlasCellCapacity(const AtlasProfile& profile) {
    return static_cast<size_t>(profile.layout.columns) * profile.layout.rows;
}

static size_t DecodedAtlasBytes(const AtlasProfile& profile) {
    return static_cast<size_t>(profile.layout.width) * profile.layout.height * 4;
}

static size_t ExpectedFontEntryCount(const ArchiveProfile& profile) {
    size_t count = 0;
    for (size_t index = 0; index < profile.atlasProfileCount; ++index) {
        const AtlasProfile& atlas = profile.atlasProfiles[index];
        size_t pageCount = atlas.pageNumberCount != 0
            ? atlas.pageNumberCount : static_cast<size_t>(atlas.pageCount);
        count += pageCount * atlas.styleCount;
    }
    return count;
}

static bool IsAtlasPageConfigured(const AtlasProfile& profile, int page) {
    if (page < 1 || static_cast<DWORD>(page) > profile.pageCount) return false;
    if (!profile.pageNumbers || profile.pageNumberCount == 0) return true;
    for (size_t index = 0; index < profile.pageNumberCount; ++index) {
        if (profile.pageNumbers[index] == page) return true;
    }
    return false;
}

static int FindStyleIndex(const AtlasProfile& profile, unsigned char style) {
    for (size_t index = 0; index < profile.styleCount; ++index) {
        if (profile.styles[index] == style) return static_cast<int>(index);
    }
    return -1;
}

static bool DecodeDbcsGlyph(UINT codepage, BYTE lead, BYTE trail,
    UINT32* glyph) {
    if (!glyph) return false;
    char encoded[2] = {
        static_cast<char>(lead),
        static_cast<char>(trail),
    };
    wchar_t decoded[2] = {};
    int length = orgMultiByteToWideChar(codepage, MB_ERR_INVALID_CHARS,
        encoded, _countof(encoded), decoded, _countof(decoded));
    if (length != 1 || decoded[0] == L'\0' ||
        (decoded[0] >= 0xD800 && decoded[0] <= 0xDFFF)) {
        return false;
    }
    *glyph = static_cast<UINT32>(decoded[0]);
    return true;
}

static void AppendCodepageCandidate(UINT codepage,
    std::vector<UINT>* candidates) {
    if (!candidates || codepage == 0 || !IsValidCodePage(codepage)) return;
    for (UINT existing : *candidates) {
        if (existing == codepage) return;
    }
    candidates->push_back(codepage);
}

static const std::vector<UINT>& InstalledCodepages() {
    static const std::vector<UINT> codepages = []() {
        std::vector<UINT> result;
        for (UINT codepage = 1; codepage <= 0xFFFF; ++codepage) {
            if (IsValidCodePage(codepage)) result.push_back(codepage);
        }
        return result;
    }();
    return codepages;
}

static void BuildCodepageCandidates(UINT preferredCodepage,
    bool preferProcessCodepages, std::vector<UINT>* candidates) {
    if (!candidates) return;
    candidates->clear();
    AppendCodepageCandidate(preferredCodepage, candidates);
    if (preferProcessCodepages) {
        AppendCodepageCandidate(GetACP(), candidates);
        AppendCodepageCandidate(GetOEMCP(), candidates);
        AppendCodepageCandidate(CP_UTF8, candidates);
    }
    for (UINT codepage : InstalledCodepages())
        AppendCodepageCandidate(codepage, candidates);
}

static bool GetDbcsCodepageInfo(UINT codepage, CPINFOEXW* info) {
    if (!info) return false;
    ZeroMemory(info, sizeof(*info));
    return GetCPInfoExW(codepage, 0, info) && info->MaxCharSize == 2;
}

static bool IsPrivateUseGlyph(UINT32 glyph) {
    return glyph >= 0xE000 && glyph <= 0xF8FF;
}

static bool BuildDbcs188Pages(const AtlasProfile& profile, UINT codepage,
    std::vector<std::vector<UINT32>>* pages) {
    if (!pages || !profile.encoding || AtlasCellCapacity(profile) < 188)
        return false;
    CPINFOEXW codepageInfo = {};
    if (!GetDbcsCodepageInfo(codepage, &codepageInfo)) return false;
    pages->clear();
    pages->reserve(profile.pageCount);

    size_t privateUsePages = 0;
    for (size_t range = 0; range + 1 < _countof(codepageInfo.LeadByte);
        range += 2) {
        BYTE firstLead = codepageInfo.LeadByte[range];
        BYTE lastLead = codepageInfo.LeadByte[range + 1];
        if (firstLead == 0 && lastLead == 0) break;
        if (firstLead == 0 || lastLead < firstLead) return false;
        for (unsigned lead = firstLead; lead <= lastLead; ++lead) {
            std::vector<UINT32> page;
            page.reserve(188);
            size_t validGlyphs = 0;
            size_t nonPrivateUseGlyphs = 0;
            for (int trail = 0x40; trail <= 0xFC; ++trail) {
                if (trail == 0x7F) continue;
                UINT32 glyph = 0;
                if (DecodeDbcsGlyph(codepage, static_cast<BYTE>(lead),
                    static_cast<BYTE>(trail), &glyph)) {
                    page.push_back(glyph);
                    ++validGlyphs;
                    if (!IsPrivateUseGlyph(glyph)) ++nonPrivateUseGlyphs;
                } else {
                    page.push_back(profile.encoding->invalidGlyph);
                }
            }
            if (validGlyphs == 0) continue;
            UINT32 outOfLayoutGlyph = 0;
            if (DecodeDbcsGlyph(codepage, static_cast<BYTE>(lead), 0x7F,
                &outOfLayoutGlyph)) {
                return false;
            }
            for (int trail = 0xFD; trail <= 0xFF; ++trail) {
                if (DecodeDbcsGlyph(codepage, static_cast<BYTE>(lead),
                    static_cast<BYTE>(trail), &outOfLayoutGlyph)) {
                    return false;
                }
            }
            if (nonPrivateUseGlyphs == 0) {
                if (privateUsePages >=
                    profile.encoding->privateUseLeadPageLimit) {
                    continue;
                }
                ++privateUsePages;
            }
            pages->push_back(std::move(page));
            if (pages->size() > profile.pageCount) return false;
        }
    }
    return pages->size() == profile.pageCount;
}

static bool BuildLinearDbcs192Pages(const AtlasProfile& profile, UINT codepage,
    std::vector<std::vector<UINT32>>* pages) {
    const size_t capacity = AtlasCellCapacity(profile);
    if (!pages || capacity != 192 || profile.pageCount < 2) return false;
    CPINFOEXW codepageInfo = {};
    if (!GetDbcsCodepageInfo(codepage, &codepageInfo)) return false;
    pages->clear();
    pages->reserve(profile.pageCount);

    for (size_t range = 0; range + 1 < _countof(codepageInfo.LeadByte);
        range += 2) {
        BYTE firstLead = codepageInfo.LeadByte[range];
        BYTE lastLead = codepageInfo.LeadByte[range + 1];
        if (firstLead == 0 && lastLead == 0) break;
        if (firstLead == 0 || lastLead < firstLead) return false;
        for (unsigned lead = firstLead; lead <= lastLead; ++lead) {
            std::vector<UINT32> page;
            page.reserve(capacity);
            for (int trail = 0x40; trail <= 0xFF; ++trail) {
                UINT32 glyph = 0;
                DecodeDbcsGlyph(codepage, static_cast<BYTE>(lead),
                    static_cast<BYTE>(trail), &glyph);
                page.push_back(glyph);
            }
            pages->push_back(std::move(page));
            if (pages->size() >= profile.pageCount) return false;
        }
    }

    std::vector<UINT32> asciiPage(capacity, 0);
    for (UINT32 glyph = 0x20; glyph <= 0x7E; ++glyph)
        asciiPage[glyph - 0x20] = glyph;
    pages->push_back(std::move(asciiPage));
    return pages->size() == profile.pageCount;
}

static bool DecodeSplitDbcsGlyph(const AtlasEncodingProfile& encoding,
    UINT codepage, BYTE lead, BYTE trail, UINT32* glyph) {
    if (!glyph) return false;
    // The supplied atlas generator uses the standard Big5 table. CP950 differs
    // at these symbol slots and adds codes that must remain empty here.
    if (encoding.useStandardBig5Symbols && codepage == 950) {
        switch ((static_cast<unsigned>(lead) << 8) | trail) {
        case 0xA145: *glyph = 0x2022; return true;
        case 0xA14E: *glyph = 0xFF64; return true;
        case 0xA1C2: *glyph = 0x203E; return true;
        case 0xA1E3: *glyph = 0x223C; return true;
        case 0xA1F2: *glyph = 0x2641; return true;
        case 0xA1F3: *glyph = 0x2609; return true;
        case 0xA241: *glyph = 0xFF0F; return true;
        case 0xA242: *glyph = 0xFF3C; return true;
        case 0xA244: *glyph = 0x00A5; return true;
        case 0xA246: *glyph = 0x00A2; return true;
        case 0xA247: *glyph = 0x00A3; return true;
        case 0xA3E1:
            return false;
        default:
            if (lead == 0xF9 && trail >= 0xD6) return false;
            break;
        }
    }
    return DecodeDbcsGlyph(codepage, lead, trail, glyph);
}

static bool BuildSplitDbcs160Pages(const AtlasProfile& profile, UINT codepage,
    bool appendAsciiPage, std::vector<std::vector<UINT32>>* pages) {
    const size_t capacity = AtlasCellCapacity(profile);
    if (!pages || !profile.encoding || capacity != 160 ||
        profile.pageCount == 0 ||
        (appendAsciiPage && profile.pageCount < 2)) {
        return false;
    }
    DWORD dbcsPageCount = profile.pageCount - (appendAsciiPage ? 1 : 0);
    if (dbcsPageCount == 0 || dbcsPageCount > 95) return false;
    CPINFOEXW codepageInfo = {};
    if (!GetDbcsCodepageInfo(codepage, &codepageInfo)) return false;
    pages->clear();
    pages->reserve(profile.pageCount);

    for (DWORD pageIndex = 0; pageIndex < dbcsPageCount; ++pageIndex) {
        BYTE lead = static_cast<BYTE>(0xA1 + pageIndex);
        std::vector<UINT32> page(capacity, 0);
        size_t trailIndex = 0;
        size_t validGlyphs = 0;
        UINT32 gapGlyph = 0;
        for (int trail = 0x7F; trail <= 0xA0; ++trail) {
            if (DecodeDbcsGlyph(codepage, lead, static_cast<BYTE>(trail),
                &gapGlyph)) {
                return false;
            }
        }
        for (int trail = 0x40; trail <= 0x7E; ++trail, ++trailIndex) {
            if (DecodeSplitDbcsGlyph(*profile.encoding, codepage, lead,
                static_cast<BYTE>(trail), &page[trailIndex])) {
                ++validGlyphs;
            }
        }
        for (int trail = 0xA1; trail <= 0xFE; ++trail, ++trailIndex) {
            size_t slot = trailIndex + 2;
            if (DecodeSplitDbcsGlyph(*profile.encoding, codepage, lead,
                static_cast<BYTE>(trail), &page[slot])) {
                ++validGlyphs;
            }
        }
        if (validGlyphs == 0) return false;
        pages->push_back(std::move(page));
    }
    if (appendAsciiPage) {
        std::vector<UINT32> asciiPage(capacity, 0);
        for (UINT32 glyph = 0x20; glyph <= 0x7E; ++glyph)
            asciiPage[glyph - 0x20] = glyph;
        pages->push_back(std::move(asciiPage));
    }
    return pages->size() == profile.pageCount;
}

static bool BuildAtlasPagesForCodepage(const AtlasProfile& profile,
    UINT codepage, std::vector<std::vector<UINT32>>* pages) {
    if (!profile.encoding || !pages) return false;
    switch (profile.encoding->byteLayout) {
    case AtlasByteLayout::Dbcs188:
        return BuildDbcs188Pages(profile, codepage, pages);
    case AtlasByteLayout::LinearDbcs192WithAscii:
        return BuildLinearDbcs192Pages(profile, codepage, pages);
    case AtlasByteLayout::SplitDbcs160:
        return BuildSplitDbcs160Pages(profile, codepage, false, pages);
    case AtlasByteLayout::SplitDbcs160WithAscii:
        return BuildSplitDbcs160Pages(profile, codepage, true, pages);
    default:
        return false;
    }
}

static bool BuildAtlasCharacterMaps(const AtlasProfile& profile,
    AtlasSetState* state) {
    if (!profile.encoding || !state) return false;
    state->automaticCodepage = 0;
    state->characterMaps.clear();

    std::vector<UINT> candidates;
    BuildCodepageCandidates(profile.encoding->preferredCodepage, false,
        &candidates);
    for (UINT codepage : candidates) {
        AtlasCharacterMapState characterMap = {};
        characterMap.codepage = codepage;
        if (!BuildAtlasPagesForCodepage(profile, codepage,
            &characterMap.pages)) {
            continue;
        }
        if (state->automaticCodepage == 0)
            state->automaticCodepage = codepage;
        state->characterMaps.push_back(std::move(characterMap));
    }
    return state->automaticCodepage != 0 && !state->characterMaps.empty();
}

} // namespace Yuris
