enum class BgiLineDecoderAbi {
    None,
    Fastcall,
    LegacyX86Registers,
};

enum class BgiLinePatchResult {
    NotScript,
    NoMatch,
    Ambiguous,
    Patched,
};

struct BgiLineWildcard {
    size_t offset;
    size_t length;
};

struct BgiLineScriptLayout {
    const char* name;
    const BYTE* pattern;
    size_t patternSize;
    const BgiLineWildcard* wildcards;
    size_t wildcardCount;
    const BYTE* replacement;
    size_t replacementSize;
    bool hasCodeReference;
};

struct BgiLineImageView {
    BYTE* base;
    size_t size;
    IMAGE_SECTION_HEADER* sections;
    WORD sectionCount;
};

using BgiLineFastcallDecoder = int (__fastcall*)(BYTE* output, const void* source);

static BgiLineFastcallDecoder g_bgiLineOriginalFastcallDecoder = nullptr;
static volatile LONG g_bgiLineFontActive = 0;
static volatile LONG g_bgiLineApplyTraceCount = 0;
static volatile LONG g_bgiLineAmbiguousTraceCount = 0;

#ifndef _WIN64
using BgiLineLegacyRegisterDecoder = int (__cdecl*)();
static BgiLineLegacyRegisterDecoder g_bgiLineOriginalLegacyRegisterDecoder = nullptr;
#endif

