// Window visibility animation.
enum PickerWindowAnimationKind {
    PICKER_WINDOW_ANIMATION_NONE = 0,
    PICKER_WINDOW_ANIMATION_SHOW,
    PICKER_WINDOW_ANIMATION_HIDE,
};

static const UINT_PTR PICKER_WINDOW_ANIMATION_TIMER_ID = 0x5346;
static const UINT PICKER_WINDOW_ANIMATION_FRAME_MS = 15;
static const DWORD PICKER_WINDOW_ANIMATION_DURATION_MS = 160;
static const BYTE PICKER_WINDOW_OPACITY = 245;
static const int PICKER_WINDOW_SHOW_OFFSET = 12;
static const int PICKER_WINDOW_HIDE_OFFSET = 10;

static PickerWindowAnimationKind g_pickerWindowAnimation = PICKER_WINDOW_ANIMATION_NONE;
static DWORD g_pickerAnimationStartTick = 0;
static RECT g_pickerAnimationRestRect = { 0, 0, 0, 0 };
static int g_pickerAnimationStartY = 0;
static int g_pickerAnimationTargetY = 0;
static BYTE g_pickerAnimationStartAlpha = PICKER_WINDOW_OPACITY;
static BYTE g_pickerAnimationTargetAlpha = PICKER_WINDOW_OPACITY;
static BYTE g_pickerAnimationCurrentAlpha = PICKER_WINDOW_OPACITY;

static bool PickerWindowAnimationsEnabled() {
    BOOL enabled = TRUE;
    if (SystemParametersInfoW(SPI_GETCLIENTAREAANIMATION, 0, &enabled, 0))
        return enabled != FALSE;
    return true;
}

static void SetPickerWindowVisual(HWND hWnd, int y, BYTE alpha) {
    if (!hWnd || !IsWindow(hWnd)) return;

    SetLayeredWindowAttributes(hWnd, 0, alpha, LWA_ALPHA);
    g_pickerAnimationCurrentAlpha = alpha;

    RECT current = {};
    if (GetWindowRect(hWnd, &current) &&
        (current.left != g_pickerAnimationRestRect.left || current.top != y)) {
        SetWindowPos(hWnd, NULL, g_pickerAnimationRestRect.left, y, 0, 0,
            SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
    }
}

static void StopPickerWindowAnimationTimer(HWND hWnd) {
    if (hWnd && IsWindow(hWnd))
        KillTimer(hWnd, PICKER_WINDOW_ANIMATION_TIMER_ID);
    g_pickerWindowAnimation = PICKER_WINDOW_ANIMATION_NONE;
}

static void CompletePickerWindowAnimation(HWND hWnd) {
    PickerWindowAnimationKind completed = g_pickerWindowAnimation;
    StopPickerWindowAnimationTimer(hWnd);
    if (!hWnd || !IsWindow(hWnd)) return;

    if (completed == PICKER_WINDOW_ANIMATION_SHOW) {
        SetPickerWindowVisual(hWnd, g_pickerAnimationRestRect.top, PICKER_WINDOW_OPACITY);
        g_visible = true;
        return;
    }

    SetPickerWindowVisual(hWnd, g_pickerAnimationTargetY, 0);
    SetPickerWindowVisual(hWnd, g_pickerAnimationRestRect.top, 0);
    if (completed == PICKER_WINDOW_ANIMATION_HIDE)
        ShowWindow(hWnd, SW_HIDE);
    SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
    g_pickerAnimationCurrentAlpha = PICKER_WINDOW_OPACITY;
    g_visible = false;
}

static bool AdvancePickerWindowAnimation(HWND hWnd) {
    if (g_pickerWindowAnimation == PICKER_WINDOW_ANIMATION_NONE)
        return false;

    DWORD elapsed = GetTickCount() - g_pickerAnimationStartTick;
    float t = (float)elapsed / (float)PICKER_WINDOW_ANIMATION_DURATION_MS;
    if (t > 1.0f) t = 1.0f;
    float eased = t * t * (3.0f - 2.0f * t);

    int y = g_pickerAnimationStartY +
        (int)((g_pickerAnimationTargetY - g_pickerAnimationStartY) * eased);
    int alpha = (int)g_pickerAnimationStartAlpha +
        (int)((g_pickerAnimationTargetAlpha - g_pickerAnimationStartAlpha) * eased);
    SetPickerWindowVisual(hWnd, y, (BYTE)max(0, min(255, alpha)));

    if (elapsed >= PICKER_WINDOW_ANIMATION_DURATION_MS)
        CompletePickerWindowAnimation(hWnd);
    return true;
}

static void StartPickerWindowAnimation(HWND hWnd,
    PickerWindowAnimationKind kind, int startY, int targetY,
    BYTE startAlpha, BYTE targetAlpha) {
    g_pickerWindowAnimation = kind;
    g_pickerAnimationStartTick = GetTickCount();
    g_pickerAnimationStartY = startY;
    g_pickerAnimationTargetY = targetY;
    g_pickerAnimationStartAlpha = startAlpha;
    g_pickerAnimationTargetAlpha = targetAlpha;
    if (!SetTimer(hWnd, PICKER_WINDOW_ANIMATION_TIMER_ID,
            PICKER_WINDOW_ANIMATION_FRAME_MS, NULL)) {
        CompletePickerWindowAnimation(hWnd);
    }
}

static void HidePickerWindowAnimated(HWND hWnd) {
    if (!hWnd || !IsWindow(hWnd)) return;
    if (g_pickerWindowAnimation == PICKER_WINDOW_ANIMATION_HIDE)
        return;

    if (g_scrollbarDragging && GetCapture() == hWnd) {
        g_scrollbarDragging = false;
        ReleaseCapture();
    }

    RECT current = {};
    if (!GetWindowRect(hWnd, &current)) return;
    if (g_pickerWindowAnimation != PICKER_WINDOW_ANIMATION_SHOW)
        g_pickerAnimationRestRect = current;

    g_visible = false;
    if (!PickerWindowAnimationsEnabled()) {
        StopPickerWindowAnimationTimer(hWnd);
        SetPickerWindowVisual(hWnd, g_pickerAnimationRestRect.top, PICKER_WINDOW_OPACITY);
        ShowWindow(hWnd, SW_HIDE);
        return;
    }

    int targetY = g_pickerAnimationRestRect.top - PICKER_WINDOW_HIDE_OFFSET;
    StartPickerWindowAnimation(hWnd, PICKER_WINDOW_ANIMATION_HIDE,
        current.top, targetY, g_pickerAnimationCurrentAlpha, 0);
}

static void MinimizePickerWindowNative(HWND hWnd) {
    if (!hWnd || !IsWindow(hWnd)) return;

    if (g_scrollbarDragging && GetCapture() == hWnd) {
        g_scrollbarDragging = false;
        ReleaseCapture();
    }

    if (g_pickerWindowAnimation != PICKER_WINDOW_ANIMATION_NONE) {
        StopPickerWindowAnimationTimer(hWnd);
        SetPickerWindowVisual(hWnd, g_pickerAnimationRestRect.top, PICKER_WINDOW_OPACITY);
    } else {
        SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
        g_pickerAnimationCurrentAlpha = PICKER_WINDOW_OPACITY;
    }

    g_visible = false;
    SendMessageW(hWnd, WM_SYSCOMMAND, SC_MINIMIZE, 0);
}

static void ShowPickerWindowAnimated(HWND hWnd) {
    if (!hWnd || !IsWindow(hWnd)) return;
    if (IsIconic(hWnd)) {
        StopPickerWindowAnimationTimer(hWnd);
        SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
        g_pickerAnimationCurrentAlpha = PICKER_WINDOW_OPACITY;
        g_visible = true;
        ShowWindow(hWnd, SW_RESTORE);
        return;
    }
    if (g_pickerWindowAnimation == PICKER_WINDOW_ANIMATION_SHOW) {
        g_visible = true;
        return;
    }

    bool reversingExit = g_pickerWindowAnimation == PICKER_WINDOW_ANIMATION_HIDE;
    RECT current = {};
    g_visible = true;

    if (!PickerWindowAnimationsEnabled()) {
        StopPickerWindowAnimationTimer(hWnd);
        if (!reversingExit) {
            if (!GetWindowRect(hWnd, &current)) {
                SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
                g_visible = IsWindowVisible(hWnd) != FALSE && !IsIconic(hWnd);
                return;
            }
            g_pickerAnimationRestRect = current;
        }
        SetPickerWindowVisual(hWnd, g_pickerAnimationRestRect.top, PICKER_WINDOW_OPACITY);
        ShowWindow(hWnd, SW_SHOWNOACTIVATE);
        return;
    }

    if (reversingExit) {
        if (!GetWindowRect(hWnd, &current)) {
            g_visible = false;
            return;
        }
        StartPickerWindowAnimation(hWnd, PICKER_WINDOW_ANIMATION_SHOW,
            current.top, g_pickerAnimationRestRect.top,
            g_pickerAnimationCurrentAlpha, PICKER_WINDOW_OPACITY);
        return;
    }

    SetLayeredWindowAttributes(hWnd, 0, 0, LWA_ALPHA);
    if (!GetWindowRect(hWnd, &current)) {
        SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
        g_visible = false;
        return;
    }
    ShowWindow(hWnd, SW_SHOWNOACTIVATE);
    g_pickerAnimationRestRect = current;
    int startY = current.top + PICKER_WINDOW_SHOW_OFFSET;
    SetWindowPos(hWnd, NULL, current.left, startY, 0, 0,
        SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
    g_pickerAnimationCurrentAlpha = 0;
    InvalidateRect(hWnd, NULL, FALSE);
    UpdateWindow(hWnd);
    StartPickerWindowAnimation(hWnd, PICKER_WINDOW_ANIMATION_SHOW,
        startY, current.top, 0, PICKER_WINDOW_OPACITY);
}

static void CancelPickerWindowAnimation(HWND hWnd) {
    StopPickerWindowAnimationTimer(hWnd);
    if (hWnd && IsWindow(hWnd))
        SetLayeredWindowAttributes(hWnd, 0, PICKER_WINDOW_OPACITY, LWA_ALPHA);
    g_pickerAnimationCurrentAlpha = PICKER_WINDOW_OPACITY;
}
